# Civic-Workbench: the specified ESP32S NodeMCU / NodeMCU-32S (classic ESP32).
# Board profile is not permission to flash or connect to a vehicle.
CONFIG_IDF_TARGET="esp32"
# Hardware initialization, bitrate evidence and physical transmission remain disabled.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
