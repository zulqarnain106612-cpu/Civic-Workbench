{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civic-workbench.invalid/schemas/v1/capture-stop.schema.json",
  "title": "Civic-Workbench capture-stop command",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "request_id", "session_id", "requested_at_utc", "requested_by"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "capture_stop"},
    "request_id": {"type": "string", "format": "uuid"},
    "session_id": {"type": "string", "format": "uuid"},
    "requested_at_utc": {"type": "string", "format": "date-time"},
    "requested_by": {"type": "string", "minLength": 1, "maxLength": 128},
    "reason": {"type": "string", "maxLength": 1000}
  }
}
