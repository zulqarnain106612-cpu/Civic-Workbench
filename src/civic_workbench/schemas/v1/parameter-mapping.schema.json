{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civic-workbench.invalid/schemas/v1/parameter-mapping.schema.json",
  "title": "Civic-Workbench user-reviewed parameter mapping",
  "description": "Versioned decoder definition linked to raw evidence. Candidate mappings are not verified vehicle parameters.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "mapping_id", "session_id", "created_at_utc", "name", "version", "definition", "status", "evidence_frame_ids", "method"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "parameter_mapping"},
    "mapping_id": {"type": "string", "format": "uuid"},
    "session_id": {"type": "string", "format": "uuid"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "version": {"type": "integer", "minimum": 1},
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_bit", "bit_length", "byte_order", "signed", "scale", "offset", "unit"],
      "properties": {
        "start_bit": {"type": "integer", "minimum": 0, "maximum": 63},
        "bit_length": {"type": "integer", "minimum": 1, "maximum": 64},
        "byte_order": {"enum": ["little_endian", "big_endian", "unknown"]},
        "signed": {"type": ["boolean", "null"]},
        "scale": {"type": ["number", "null"]},
        "offset": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"], "maxLength": 64}
      }
    },
    "status": {"enum": ["candidate", "validated"]},
    "evidence_frame_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uuid"}, "uniqueItems": true},
    "method": {"type": "string", "minLength": 1, "maxLength": 1000},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation_method", "validated_at_utc", "evidence_refs"],
      "properties": {
        "validation_method": {"type": "string", "minLength": 1, "maxLength": 1000},
        "validated_at_utc": {"type": "string", "format": "date-time"},
        "reviewer": {"type": ["string", "null"], "maxLength": 128},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "validated"}}, "required": ["status"]}, "then": {"required": ["validation"]}}
  ]
}
